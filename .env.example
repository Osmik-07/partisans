# Telegram Bot
BOT_TOKEN=your_bot_token_here
# Один ID или несколько через запятую: ADMIN_IDS=111111111,222222222
ADMIN_IDS=123456789

# Pyrogram (MTProto) — получить на my.telegram.org → API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
USERBOT_SESSION_SECRET=2e34ca97034b61ccbda83786cf19772f6b97768d03ad67b1f0cce0d3980216f8

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=notspybot
DB_USER=notspybot
DB_PASS=strongpassword

# Redis
REDIS_URL=redis://redis:6379/0

# CryptoBot
CRYPTOBOT_TOKEN=your_cryptobot_token
CRYPTOBOT_WEBHOOK_SECRET=your_secret_string

# Webhook (оставь пустым для polling-режима)
WEBHOOK_HOST=
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8443

# Цены подписок (USD)
PRICE_TRIAL_DAYS=3
PRICE_WEEK_USD=1.00
PRICE_MONTH_USD=2.00
PRICE_YEAR_USD=10.00

# Telegram Stars
PRICE_WEEK_STARS=50
PRICE_MONTH_STARS=100
PRICE_YEAR_STARS=500

# Цены в рублях (СБП). Продублированы в miniapp/legal.json —
# ops/publish_legal.py сверяет их и не даст опубликовать расхождение.
PRICE_WEEK_RUB=99
PRICE_MONTH_RUB=149
PRICE_YEAR_RUB=799

# СБП: включить, когда эквайер (PlateGo) выдаст доступ. Пока false — экран «скоро».
SBP_ENABLED=false

# Protection (разовый продукт «Защита от перехвата»)
PRICE_PROTECTION_USD=100.00
PRICE_PROTECTION_STARS=5000

# Поддержка и документы (требование эквайринга)
SUPPORT_CONTACT=@partisansfromNJ
PRIVACY_URL=https://telegra.ph/Politika-konfidencialnosti--Partisans-09-19
